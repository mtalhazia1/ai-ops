{
  "name": "WF5 Daily digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * *"
            }
          ]
        }
      },
      "id": "bb02daf2-e054-5dc1-b370-efb10076b26a",
      "name": "Every day at 18:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "id": "3814cb80-67a1-5190-87ca-437dff6a00ed",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.APP_URL }}/internal/metrics?period=today",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{ $env.INTERNAL_TOKEN }}"
            },
            {
              "name": "X-N8N-Execution-Id",
              "value": "={{ $execution.id }}"
            }
          ]
        }
      },
      "id": "3a3ebd02-a49d-524c-8f9a-0bb8c8042713",
      "name": "Today's metrics (Django)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.SLACK_API_URL || 'https://slack.com/api') }}/chat.postMessage",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $env.SLACK_CHANNEL_DIGEST || '#ops-review', text: $json.digest_text, unfurl_links: false }) }}"
      },
      "id": "a17a5c38-9f09-5900-96e0-c42d65facc4d",
      "name": "Slack digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "credentials": {
        "slackApi": {
          "id": "",
          "name": "Slack"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "7953e057-aa30-567a-8549-3fcac8dd11a4",
              "leftValue": "={{ $json.ok }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3de93e97-0af4-59f4-992b-7ba2b2fe95e6",
      "name": "Slack ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "errorMessage": "=Slack error: {{ $json.error }}"
      },
      "id": "9b004f40-147d-591a-be6b-7abb1d6f52b4",
      "name": "Slack failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        880,
        120
      ]
    }
  ],
  "connections": {
    "Every day at 18:00": {
      "main": [
        [
          {
            "node": "Today's metrics (Django)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Today's metrics (Django)": {
      "main": [
        [
          {
            "node": "Slack digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Slack digest": {
      "main": [
        [
          {
            "node": "Slack ok?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now": {
      "main": [
        [
          {
            "node": "Today's metrics (Django)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Slack ok?": {
      "main": [
        [],
        [
          {
            "node": "Slack failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "errorWorkflow": "wf4error00000001",
    "timezone": "Asia/Karachi"
  },
  "pinData": {},
  "active": false,
  "id": "wf5digest0000001",
  "tags": []
}